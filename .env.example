# =====================================================================
# Proyecto Fénix — variables de entorno
#
# Uso:
#   cp .env.example .env
#
# .env NO se versiona. Nunca commitear tokens ni secretos reales.
# =====================================================================

# ---------- LocalStack ----------
# Token de autenticación de LocalStack.
# Solo si la imagen 3.8.0 lo exige: https://app.localstack.cloud
# Dejar vacío si no se usa.
LOCALSTACK_AUTH_TOKEN=

# Credenciales ficticias: LocalStack acepta cualquier valor.
# El helper del proyecto rechaza endpoints fuera de 127.0.0.1:4566.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# ---------- Fénix ----------
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-me

# Identificador del grupo: se usa en los tags GroupId y Owner.
GROUP_ID=grupo-01

# ---------- Notificaciones ----------
# console | telegram | slack
NOTIFY_PROVIDER=console

# Telegram (si NOTIFY_PROVIDER=telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack (si NOTIFY_PROVIDER=slack)
SLACK_WEBHOOK_URL=

# ---------- Logs ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5

# ---------- Worker ----------
# Ajustar a los nombres que use la plantilla de la cátedra.
QUEUE_NAME=fenix-events
DLQ_NAME=fenix-events-dlq
VISIBILITY_TIMEOUT=45
MAX_RECEIVE_COUNT=3
